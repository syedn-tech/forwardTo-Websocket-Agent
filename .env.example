# ForwardTo Agent Configuration Template

# Base URL of ForwardTo Server (defaults to https://forwardto.cloud if not specified)
# FORWARDTO_SERVER=https://forwardto.cloud

# Team API Key (from top bar copy button in ForwardTo dashboard)
FORWARDTO_TEAM_KEY=your-team-api-key

# Option A: Single client
FORWARDTO_CLIENT_ID=your-client-id
FORWARDTO_TOKEN=your-client-secret-token

# Option B: Multiple clients (comma-separated ID and token lists)
# FORWARDTO_CLIENT_ID=client-1,client-2
# FORWARDTO_TOKEN=token-1,token-2

# Option C: Multiple clients with explicit pairs (client_id:token)
# FORWARDTO_CLIENTS=client-1:token-1,client-2:token-2
