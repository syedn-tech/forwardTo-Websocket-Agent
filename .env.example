# ForwardTo Agent Configuration Template

# Base URL of ForwardTo Server
FORWARDTO_SERVER=https://forwardto.cloud

# Team API Key (from top bar copy button in ForwardTo dashboard)
FORWARDTO_TEAM_KEY=your-team-api-key

# Registered Client ID for this machine
FORWARDTO_CLIENT_ID=your-client-id

# Secret token for this client (from Endpoint Drawer in ForwardTo)
FORWARDTO_TOKEN=your-client-secret-token

# Optional: Override local target URL (if omitted, ForwardTo server configuration is used)
# TARGET_URL=http://localhost:8000/webhook
